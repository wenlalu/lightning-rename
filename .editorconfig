# https://editorconfig.org
root = true

# 项目约定：UTF-8 无 BOM；不强制行尾（历史文件 CRLF/LF 混杂，保持原样以维持与远程仓库逐字节一致）
[*]
charset = utf-8
insert_final_newline = false
trim_trailing_whitespace = false

[*.cs]
indent_style = space
indent_size = 4

[*.{csproj,sln,manifest,xml,config}]
indent_style = space
indent_size = 2

[*.{ps1,md}]
indent_style = space
indent_size = 4
